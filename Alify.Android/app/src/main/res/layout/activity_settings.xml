<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/spotify_light_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Settings &amp; Credentials"
                android:textColor="@color/spotify_light_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Section 1: Spotify Developer Connection (BYOK) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Spotify Connection (BYOK)"
                    android:textColor="@color/spotify_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpotifyGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="💡 Setup Guide &amp; User Allowlist Rules ↗"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingVertical="4dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- 1-Tap Auto-Link -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoLinkSettings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/spotify_green"
                    android:text="Auto-Link Spotify Developer App"
                    android:textColor="@color/spotify_black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <!-- Redirect URI Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/stat_box_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Redirect URI: "
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvRedirectUri"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="ujify://callback"
                        android:textColor="@color/spotify_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnCopyRedirectUri"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy URI"
                        android:padding="6dp"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/spotify_light_text" />
                </LinearLayout>

                <!-- Input Client ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Spotify Client ID"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSpotifyClientId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/stat_box_background"
                    android:hint="32-character hex Client ID"
                    android:textColorHint="@color/spotify_sub_text"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:inputType="textNoSuggestions"
                    android:singleLine="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2: Ethos Worldview & Guardrails -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Ethos Guardrails &amp; Interventions"
                    android:textColor="@color/spotify_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Ethos Profile Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ethos Profile:"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spProfileSettings"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>

                <!-- Strictness Level Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStrictnessLabelSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Strictness: 10/10"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/sbStrictnessSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:max="10"
                        android:min="1"
                        android:progress="10" />
                </LinearLayout>

                <!-- Custom Ethos Directive Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Custom Ethos Directive"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCustomEthosPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/stat_box_background"
                    android:hint="e.g. Allow romance, block drill &amp; club themes..."
                    android:textColorHint="@color/spotify_sub_text"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 3: AI Semantic Engine & API Keys (BYOK) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Semantic AI Stance Engine"
                    android:textColor="@color/spotify_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- API Key Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAiApiKey"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="AI API Key (Optional BYOK)"
                    app:boxStrokeColor="@color/spotify_green"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/spotify_sub_text"
                    app:hintTextColor="@color/spotify_green">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAiApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Key Helper Link -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Community keys active. Or get personal key:"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetApiKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Get API Key ↗"
                        android:textColor="@color/spotify_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Technical Settings Toggle (Non-intrusive for everyday users) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleAdvancedAi"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="2dp"
                    android:gravity="start|center_vertical"
                    android:paddingHorizontal="0dp"
                    android:text="Technical Settings (Custom Model &amp; Endpoint)"
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="12sp" />

                <!-- Collapsible Advanced Technical Section -->
                <LinearLayout
                    android:id="@+id/llAdvancedAiContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAiCustomModel"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="Custom Model ID (Optional)"
                        app:boxStrokeColor="@color/spotify_green"
                        app:hintTextColor="@color/spotify_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAiCustomModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textNoSuggestions"
                            android:textColor="@color/spotify_light_text"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAiCustomEndpoint"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Custom Base URL (Optional)"
                        app:boxStrokeColor="@color/spotify_green"
                        app:hintTextColor="@color/spotify_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAiCustomEndpoint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="@color/spotify_light_text"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Supports any OpenAI-compatible API (DeepSeek, Ollama, Together), Claude, Groq, and Gemini. Leave blank for auto-configuration."
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 4: Persistent Credential Vault & Backup -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4. Persistent Vault (Backup)"
                        android:textColor="@color/spotify_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVaultStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking..."
                        android:textColor="@color/spotify_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackupVault"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Backup Vault"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/spotify_green" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestoreVault"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Restore Vault"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/spotify_green" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 5: App Version & Updates -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Installed: v1.9.7"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conscious music sentinel &amp; DJ"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckUpdates"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Check Updates"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="13sp"
                    app:cornerRadius="6dp"
                    app:strokeColor="@color/spotify_green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/spotify_green"
            android:text="Save Settings"
            android:textColor="@color/spotify_black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />

    </LinearLayout>
</ScrollView>
