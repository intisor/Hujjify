<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/spotify_light_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Settings &amp; Credentials"
                android:textColor="@color/spotify_light_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTop"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Save"
                android:textColor="@color/spotify_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Section 1: Spotify Developer Connection (BYOK) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Spotify Connection (BYOK)"
                    android:textColor="@color/spotify_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Use your personal Developer Client ID for unlimited, unthrottled monitoring."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="11sp" />

                <!-- 1-Tap Auto-Link & Dashboard Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAutoLinkSettings"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/spotify_green"
                        android:text="1-Tap Auto-Link"
                        android:textColor="@color/spotify_black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenSpotifyDashboard"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Dashboard ↗"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="11sp"
                        app:cornerRadius="6dp"
                        app:strokeColor="@color/spotify_sub_text" />
                </LinearLayout>

                <!-- Redirect URI Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/stat_box_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Redirect URI: "
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvRedirectUri"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="hujjify://callback"
                        android:textColor="@color/spotify_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnCopyRedirectUri"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy URI"
                        android:padding="6dp"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/spotify_light_text" />
                </LinearLayout>

                <!-- Input Client ID -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSpotifyClientId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Paste Spotify Client ID"
                    app:boxBackgroundColor="@color/spotify_black"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:boxStrokeColor="@color/spotify_green"
                    app:endIconMode="clear_text"
                    app:hintTextColor="@color/spotify_sub_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSpotifyClientId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:paddingVertical="8dp"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2: Ethos Worldview & Guardrails -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Ethos Guardrails &amp; Interventions"
                    android:textColor="@color/spotify_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Ethos Profile Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ethos Profile:"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spProfileSettings"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>

                <!-- Strictness Level Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStrictnessLabelSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Strictness: 10/10"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/sbStrictnessSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:max="10"
                        android:min="1"
                        android:progress="10" />
                </LinearLayout>

                <!-- Checkboxes Group (Compact) -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbEnableVibeSwap"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="AI Vibe-Swap (Auto-replace flagged songs)"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="12sp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbEnableSurgicalDucking"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checked="true"
                    android:text="Radio Edit (Surgical word ducking on isolated flags)"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="12sp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbExplicitSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checked="false"
                    android:text="Strict Metadata: Skip Spotify [E] Explicit tags"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="12sp" />

                <!-- Compact Natural Language Directive -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Custom Ethos Directive:"
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="11sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomEthosPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:hint="e.g. 'Allow romance, block drill and clubs'..."
                    app:boxBackgroundColor="@color/spotify_black"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:boxStrokeColor="@color/spotify_green"
                    app:hintTextColor="@color/spotify_sub_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomEthosPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="2"
                        android:paddingVertical="8dp"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 3: AI Semantic Engine & API Keys (BYOK) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3. AI Semantic Engine (BYOK)"
                        android:textColor="@color/spotify_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbEnableAi"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:checked="true"
                        android:text="Enabled"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- API Key Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAiApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="AI Key (Gemini AIza..., Groq gsk_..., OpenRouter sk-...)"
                    app:boxBackgroundColor="@color/spotify_black"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:boxStrokeColor="@color/spotify_green"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/spotify_sub_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAiApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:paddingVertical="8dp"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Engine Mode Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Engine Mode:"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spAnalysisMode"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAnalysisModeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AI Semantic Engine is authoritative; regex runs only as offline fallback."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="10sp" />

                <!-- Free Key Helper Links in a Single Horizontal Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Get Key: "
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetGeminiKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingHorizontal="4dp"
                        android:text="Gemini ↗"
                        android:textColor="@color/accent_blue"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetGroqKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingHorizontal="4dp"
                        android:text="Groq ↗"
                        android:textColor="@color/accent_blue"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetOpenRouterKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingHorizontal="4dp"
                        android:text="OpenRouter ↗"
                        android:textColor="@color/accent_blue"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 4: Persistent Credential Vault & Backup -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4. Persistent Vault (Backup)"
                        android:textColor="@color/spotify_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVaultStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking..."
                        android:textColor="@color/spotify_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackupVault"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Backup"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="11sp"
                        app:cornerRadius="6dp"
                        app:strokeColor="@color/spotify_green" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestoreVault"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Restore"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="11sp"
                        app:cornerRadius="6dp"
                        app:strokeColor="@color/spotify_green" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportVault"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Export"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportVault"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Import"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 5: App Version & Updates -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Installed: v1.9.2"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conscious music sentinel &amp; DJ"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckUpdates"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Check Updates"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="11sp"
                    app:cornerRadius="6dp"
                    app:strokeColor="@color/spotify_green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/spotify_green"
            android:text="Save Settings"
            android:textColor="@color/spotify_black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="22dp" />

    </LinearLayout>
</ScrollView>
