<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- App Brand Header with Settings Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hujjify"
                    android:textColor="@color/spotify_green"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conscious Music &amp; Spotify Lyric Sentinel"
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings &amp; Credentials"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/spotify_light_text" />
        </LinearLayout>

        <!-- Setup Notice Card (Visible when Spotify Client ID is not yet configured) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSetupNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="10dp"
            app:strokeColor="@color/accent_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Developer Client ID Required"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="1dp"
                    android:text="Spotify limits unverified developer apps. Add your personal Spotify Developer Client ID for unlimited access."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAutoLinkSpotify"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/spotify_green"
                        android:text="⚡ 1-Tap Auto-Link"
                        android:textColor="@color/spotify_black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetupClientId"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Manual Keys"
                        android:textSize="11sp"
                        android:textColor="@color/spotify_light_text"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/spotify_sub_text" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Playback & Protection Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Ready to Connect"
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="No track playing"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect Spotify to start monitoring"
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSafetyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/badge_clean"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="✓ Status: Clean"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Button to Open Lyrics & Stance Audit -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewLyrics"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:text="📜 View Lyrics &amp; Annotations"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:cornerRadius="6dp"
                    app:strokeColor="@color/spotify_green" />

                <!-- Active Filter Configuration Display -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/spotify_black" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvActiveEthos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Active Ethos: Islamic (10/10)"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvChangeSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="2dp"
                        android:text="Change"
                        android:textColor="@color/spotify_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Conscious Audio Streak Card (StreakKit Drop-In) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="10dp"
            app:strokeColor="#f59e0b"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStreakFlame"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStreakCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Day Streak"
                                android:textColor="#f59e0b"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStreakStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/stat_box_background"
                                android:paddingHorizontal="5dp"
                                android:paddingVertical="1dp"
                                android:text="Tap to view"
                                android:textColor="@color/spotify_sub_text"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStreakProgressSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Track your daily conscious audio habit"
                            android:textColor="@color/spotify_sub_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStreakFreezes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️ 2/2"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/streakProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="3"
                    android:progress="0"
                    app:indicatorColor="#f59e0b"
                    app:trackColor="@color/spotify_black"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI Ethos DJ Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiDj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="10dp"
            app:strokeColor="@color/spotify_green"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎧 AI Ethos DJ"
                        android:textColor="@color/spotify_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDjStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ask for any vibe"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Vibe Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipWorkout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/stat_box_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="⚡ Workout Hype"
                            android:textColor="@color/spotify_light_text"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipFocus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/stat_box_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="📚 Deep Focus"
                            android:textColor="@color/spotify_light_text"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipDrive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/stat_box_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="🌙 Peaceful Drive"
                            android:textColor="@color/spotify_light_text"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipGrateful"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/stat_box_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="🤲 Shukr &amp; Soul"
                            android:textColor="@color/spotify_light_text"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Prompt Input Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etDjPrompt"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/stat_box_background"
                        android:hint="Ask AI DJ: 'Calm acoustic Afrobeat'..."
                        android:textColorHint="@color/spotify_sub_text"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpinDj"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/spotify_green"
                        android:text="Spin ▶"
                        android:textColor="@color/spotify_black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="6dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Protection Dashboard & Analytics Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:contentPadding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header with Title and Reset Stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 Protection Analytics"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnResetStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Reset Stats"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- 4 Metrics Grid: Audited, Skipped, Flagged, No Lyrics -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:layout_marginBottom="8dp">

                    <!-- Audited / Played -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_background"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="2dp"
                        android:layout_marginEnd="2dp">

                        <TextView
                            android:id="@+id/tvStatPlayed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/spotify_green"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audited"
                            android:textColor="@color/spotify_sub_text"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Clean -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_background"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="2dp"
                        android:layout_marginHorizontal="2dp">

                        <TextView
                            android:id="@+id/tvStatClean"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/spotify_green"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clean"
                            android:textColor="@color/spotify_sub_text"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Flagged & Skipped -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_background"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="2dp"
                        android:layout_marginHorizontal="2dp">

                        <TextView
                            android:id="@+id/tvStatFlagged"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/flag_red"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Skipped"
                            android:textColor="@color/spotify_sub_text"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- No Lyrics -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_background"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="2dp"
                        android:layout_marginStart="2dp">

                        <TextView
                            android:id="@+id/tvStatNoLyrics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/accent_blue"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Lyrics"
                            android:textColor="@color/spotify_sub_text"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/spotify_black"
                    android:layout_marginBottom="6dp" />

                <!-- Recent Activity Feed Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Song Audits"
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <!-- Recent Tracks Container -->
                <LinearLayout
                    android:id="@+id/layoutRecentTracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvNoRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No songs audited yet. Play music on Spotify to see activity."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="11sp"
                    android:fontStyle="italic"
                    android:paddingVertical="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="@color/spotify_green"
            android:text="Connect with Spotify"
            android:textColor="@color/spotify_black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleProtection"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="@color/accent_blue"
            android:text="Start Protection"
            android:textColor="@color/spotify_light_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="22dp" />

    </LinearLayout>
</ScrollView>
