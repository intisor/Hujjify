<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/spotify_dark_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/spotify_light_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sanctuary Playlists"
                android:textColor="@color/spotify_light_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clone &amp; clean any playlist"
                android:textColor="@color/spotify_sub_text"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:padding="8dp"
            android:src="@drawable/ic_sanctuary_playlist"
            app:tint="@color/spotify_green" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Active Mirror Progress Card (Visible during mirror operation) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMirrorProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/spotify_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:contentPadding="14dp"
                app:strokeColor="@color/spotify_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProgressTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sanctifying Playlist..."
                        android:textColor="@color/spotify_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProgressStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Auditing tracks..."
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="12sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbMirror"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:indeterminate="true"
                        app:indicatorColor="@color/spotify_green"
                        app:trackColor="@color/spotify_black"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="4dp" />

                    <LinearLayout
                        android:id="@+id/layoutProgressStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCleanPreserved"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Preserved: 0"
                            android:textColor="@color/spotify_green"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvVibeReplaced"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Swapped: 0"
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenInSpotify"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/spotify_green"
                        android:text="Open Sanctuary Playlist in Spotify"
                        android:textColor="@color/spotify_black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/pbLoadingPlaylists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="32dp"
                android:indeterminateTint="@color/spotify_green" />

            <!-- Empty / Instructions View -->
            <TextView
                android:id="@+id/tvEmptyPlaylists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Connect Spotify to see and sanctify your playlists."
                android:textColor="@color/spotify_sub_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantPermissions"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/spotify_green"
                android:text="Grant Playlist Access (1-Tap)"
                android:textColor="@color/spotify_black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="8dp" />

            <!-- Container for Playlists List -->
            <LinearLayout
                android:id="@+id/layoutPlaylistsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
